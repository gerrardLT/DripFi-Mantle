# Mantle Network RPC URLs
MANTLE_TESTNET_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_MAINNET_RPC_URL=https://rpc.mantle.xyz

# Deployer Private Key (DO NOT COMMIT!)
PRIVATE_KEY=your_private_key_here

# Mantlescan API Key for contract verification
MANTLESCAN_API_KEY=your_api_key_here

# Chainlink Automation Registry (Mantle Testnet)
CHAINLINK_AUTOMATION_REGISTRY=0x...

# Token Addresses (Mantle Testnet)
USDT_ADDRESS=0x...
USDC_ADDRESS=0x...
WETH_ADDRESS=0x...
WBTC_ADDRESS=0x...
MNT_ADDRESS=0x...

# DEX Router (Uniswap V3 or equivalent on Mantle)
DEX_ROUTER_ADDRESS=0x...

# Chainlink Price Feeds (Mantle)
ETH_USD_FEED=0x...
BTC_USD_FEED=0x...
