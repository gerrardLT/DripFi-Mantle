# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token
# Get this from @BotFather on Telegram
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# Mantle Network Configuration (New)
# ============================================

# Mantle Network (testnet or mainnet)
MANTLE_NETWORK=testnet

# Mantle RPC URL
# Testnet: https://rpc.sepolia.mantle.xyz
# Mainnet: https://rpc.mantle.xyz
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz

# Contract Addresses (Mantle Sepolia Testnet)
DCA_STRATEGY_ADDRESS=0x167Be96F03aBd2Ab7476bB4e38d5b17bCA1E2b7E
DCA_VAULT_ADDRESS=0x60b863F96c146f8D33B7dC99040ef93A39C37cA5
PRICE_ORACLE_ADDRESS=0xbaEe5FBc1AA66F7B59D185925d4B7F6947041863
SWAP_HELPER_ADDRESS=0xb2888D850F6A59fff8d537305DfA51ccEf77c177

# ============================================
# Flow Network Configuration (Legacy)
# ============================================

# Flow Network (testnet or mainnet)
# Default: testnet
FLOW_NETWORK=testnet

# Flow Access Node
# Default: https://rest-testnet.onflow.org
FLOW_ACCESS_NODE=https://rest-testnet.onflow.org

# DCA Contract Address (Flow Testnet)
DCA_CONTRACT_ADDRESS=0x78acd984694957cf
